{
  "version": 6,
  "include": [
    "CMakeUnixPresets.json"
  ],
  "configurePresets": [
    {
      "name": "ThorVG",
      "inherits": "Release",
      "binaryDir": "${sourceDir}/Build/thorvg",
      "cacheVariables": {
        "ENABLE_SKIA": "OFF",
        "ENABLE_THORVG_RASTERIZER": "ON",
        "LADYBIRD_ENABLE_SPARKLE": "OFF"
      }
    },
    {
      "name": "ThorVGGL",
      "inherits": "ThorVG",
      "binaryDir": "${sourceDir}/Build/thorvg-gl",
      "cacheVariables": {
        "ENABLE_THORVG_GL": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ThorVG",
      "inherits": "base",
      "configurePreset": "ThorVG"
    },
    {
      "name": "ThorVGGL",
      "inherits": "base",
      "configurePreset": "ThorVGGL"
    }
  ]
}
